# --- Core ---------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/s6a_support"
# Public base URL of the portal (used in email links).
# Production: https://support.s6a.io   Local: http://localhost:3000
APP_URL="https://support.s6a.io"
# Canonical URL for Auth.js callbacks (production only; leave unset locally)
AUTH_URL="https://support.s6a.io"
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""

# --- SendGrid -----------------------------------------------------------
# If SENDGRID_API_KEY is empty, emails are printed to the server console instead.
SENDGRID_API_KEY=""
EMAIL_FROM="s6a Support <support@s6a.io>"
# Domain configured for SendGrid Inbound Parse (MX record points to mx.sendgrid.net).
# Replies go to ticket+<token>@REPLY_DOMAIN
REPLY_DOMAIN="reply.support.s6a.io"
# Shared secret appended to the Inbound Parse webhook URL:
#   https://support.s6a.io/api/email/inbound?secret=<INBOUND_EMAIL_SECRET>
INBOUND_EMAIL_SECRET=""

# --- SSO providers (leave blank to disable) ------------------------------
# Microsoft Entra ID (register a multi-tenant app; redirect URI:
#   https://support.s6a.io/api/auth/callback/microsoft-entra-id)
AUTH_MICROSOFT_ENTRA_ID_ID=""
AUTH_MICROSOFT_ENTRA_ID_SECRET=""

# Google Workspace (redirect URI: https://support.s6a.io/api/auth/callback/google)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Generic OIDC providers, JSON array. Each gets the provider id "oidc-<key>"
# and redirect URI https://support.s6a.io/api/auth/callback/oidc-<key>.
# For SAML IdPs, put a SAML->OIDC bridge in front (e.g. BoxyHQ SAML Jackson)
# and register the bridge here.
# OIDC_PROVIDERS='[{"key":"acme-okta","name":"Acme Okta","issuer":"https://acme.okta.com","clientId":"...","clientSecret":"..."}]'
OIDC_PROVIDERS="[]"

# --- Staff sign-in restrictions --------------------------------------------
# Your consultancy's Entra tenant ID. Required for staff to use Microsoft sign-in.
STAFF_ENTRA_TENANT_ID=""
# Optional: require staff Google sign-ins to come from this Workspace domain.
STAFF_GOOGLE_HOSTED_DOMAIN=""

# Timezone used when displaying dates
APP_TIMEZONE="Europe/London"

# --- Attachments -----------------------------------------------------------
# Private Vercel Blob store (Storage → Blob → create store; the token is added
# automatically). Without it, files are stored in ./.uploads (development only).
BLOB_READ_WRITE_TOKEN=""

# --- AI triage (Claude) ------------------------------------------------------
# Anthropic API key. Without it, AI triage is switched off everywhere.
ANTHROPIC_API_KEY=""
# Optional model override (default claude-opus-5-5)
AI_MODEL=""

# --- Scheduled jobs ----------------------------------------------------------
# Vercel sends this as a bearer token to /api/cron/sla (SLA breach alerts, AI retries).
CRON_SECRET=""
# Extra England & Wales bank holidays beyond those built in (YYYY-MM-DD, comma-separated)
BANK_HOLIDAYS_EXTRA=""
