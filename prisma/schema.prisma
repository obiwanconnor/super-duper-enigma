generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT // stakeholder at a client organisation
  AGENT // consultancy support staff
  ADMIN // consultancy admin: manages organisations, users, products
  AI // the AI triage assistant (system user, can never sign in)
}

// How members of an organisation are allowed to sign in.
enum AuthMethod {
  MAGIC_LINK
  MICROSOFT
  GOOGLE
  OIDC
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CLIENT
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum TicketType {
  QUESTION
  BUG
  FEATURE_REQUEST
  INCIDENT
}

enum CommentSource {
  WEB
  EMAIL
  AI
}

enum AiStatus {
  SKIPPED // AI disabled for this client or deployment
  PENDING
  RUNNING
  DONE
  FAILED
}

enum NoticeKind {
  INCIDENT
  MAINTENANCE
}

enum NoticeStatus {
  ACTIVE
  RESOLVED
}

enum SatisfactionRating {
  GOOD
  OKAY
  POOR
}

enum DraftStatus {
  PENDING
  SENT
  DISCARDED
  SUPERSEDED
}

model Organization {
  id                 String       @id @default(cuid())
  name               String
  slug               String       @unique
  // Email domains owned by this client, e.g. ["acme.com"]. Used to route logins.
  emailDomains       String[]
  // Anyone with a matching email domain may sign in and is added automatically.
  // When false, users must be invited individually.
  autoJoin           Boolean      @default(false)
  authMethods        AuthMethod[] @default([MAGIC_LINK])
  // Optional restrictions for SSO sign-ins.
  entraTenantId      String?
  googleHostedDomain String?
  // Key of the entry in OIDC_PROVIDERS used by this organisation.
  oidcProviderKey    String?
  // Data is kept until two years after the contract ends (see src/lib/retention.ts).
  contractEndsAt     DateTime?
  // Whether ticket content may be sent to the AI assistant for triage.
  aiEnabled          Boolean      @default(true)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  users      User[]
  products   Product[]
  tickets    Ticket[]
  slaTargets SlaTarget[]
}

// Contracted targets per priority, in business minutes (see src/lib/sla).
model SlaTarget {
  id                   String         @id @default(cuid())
  organizationId       String
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  priority             TicketPriority
  firstResponseMinutes Int
  resolutionMinutes    Int

  @@unique([organizationId, priority])
}

model Product {
  id             String       @id @default(cuid())
  name           String
  slug           String
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  tickets  Ticket[]
  articles Article[]
  notices  ServiceNotice[]

  @@unique([organizationId, slug])
}

model User {
  id             String        @id @default(cuid())
  name           String?
  email          String        @unique
  emailVerified  DateTime?
  image          String?
  role           Role          @default(CLIENT)
  // Client admins manage their own organisation's people and see its reports.
  orgAdmin       Boolean       @default(false)
  active         Boolean       @default(true)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  accounts        Account[]
  sessions        Session[]
  requested       Ticket[]               @relation("requester")
  assigned        Ticket[]               @relation("assignee")
  comments        Comment[]
  articles        Article[]
  attachments     Attachment[]
  resolvedDrafts  AiDraft[]
  watching        TicketWatcher[]        @relation("watcher")
  addedWatchers   TicketWatcher[]        @relation("watcherAddedBy")
  satisfaction    SatisfactionResponse[]
  cannedResponses CannedResponse[]
  auditEvents     AuditEvent[]
  notices         ServiceNotice[]
}

model Ticket {
  id             String         @id @default(cuid())
  number         Int            @unique @default(autoincrement())
  subject        String
  description    String
  status         TicketStatus   @default(OPEN)
  priority       TicketPriority @default(NORMAL)
  type           TicketType     @default(QUESTION)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  productId      String
  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  requesterId    String
  requester      User           @relation("requester", fields: [requesterId], references: [id])
  assigneeId     String?
  assignee       User?          @relation("assignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  resolvedAt     DateTime?

  // SLA tracking. The clock pauses while waiting on the client or resolved.
  firstRespondedAt              DateTime?
  pausedAt                      DateTime?
  pausedBusinessMinutes         Int       @default(0)
  firstResponseBreachNotifiedAt DateTime?
  resolutionBreachNotifiedAt    DateTime?

  // AI triage
  aiStatus            AiStatus        @default(SKIPPED)
  aiAttempts          Int             @default(0)
  aiUpdatedAt         DateTime?
  aiSummary           String?
  aiSuggestedType     TicketType?
  aiSuggestedPriority TicketPriority?
  aiPriorityReason    String?
  aiLikelyIncident    Boolean         @default(false)

  comments     Comment[]
  attachments  Attachment[]
  drafts       AiDraft[]
  watchers     TicketWatcher[]
  satisfaction SatisfactionResponse?
  // Linked to a known incident when it's a duplicate report.
  noticeId     String?
  notice       ServiceNotice?        @relation(fields: [noticeId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([aiStatus])
  @@index([assigneeId, status])
}

model Comment {
  id        String        @id @default(cuid())
  body      String
  // Internal notes are visible to consultancy staff only.
  internal  Boolean       @default(false)
  source    CommentSource @default(WEB)
  ticketId  String
  ticket    Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  createdAt DateTime      @default(now())

  attachments Attachment[]

  @@index([ticketId, createdAt])
}

model Attachment {
  id           String   @id @default(cuid())
  ticketId     String
  ticket       Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // Null when attached to the ticket's original description.
  commentId    String?
  comment      Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)
  filename     String
  contentType  String
  size         Int
  storageKey   String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([ticketId])
}

// A reply suggested by the AI assistant, sent only once staff approve it.
model AiDraft {
  id             String      @id @default(cuid())
  ticketId       String
  ticket         Ticket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body           String
  kbArticleSlugs String[]
  confidence     String
  status         DraftStatus @default(PENDING)
  resolvedById   String?
  resolvedBy     User?       @relation(fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  createdAt      DateTime    @default(now())

  @@index([ticketId, status])
}

model Article {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  body      String // Markdown
  published Boolean  @default(false)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, published])
}

// ---- Auth.js models -------------------------------------------------------

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  // Last request made with this session; drives the idle timeout.
  lastSeenAt   DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// Colleagues copied in on a ticket; they receive the same emails as the requester.
model TicketWatcher {
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("watcher", fields: [userId], references: [id], onDelete: Cascade)
  addedById String
  addedBy   User     @relation("watcherAddedBy", fields: [addedById], references: [id])
  createdAt DateTime @default(now())

  @@id([ticketId, userId])
}

// One satisfaction rating per ticket; responding again replaces it.
model SatisfactionResponse {
  id        String             @id @default(cuid())
  ticketId  String             @unique
  ticket    Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  userId    String
  user      User               @relation(fields: [userId], references: [id])
  rating    SatisfactionRating
  comment   String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

// Reusable reply templates for staff.
model CannedResponse {
  id          String   @id @default(cuid())
  title       String
  body        String
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Who changed what. Details hold identifiers and field values, never message bodies.
model AuditEvent {
  id         String   @id @default(cuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  summary    String
  details    Json?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
}

// Outage or planned maintenance affecting one or more products.
model ServiceNotice {
  id          String       @id @default(cuid())
  kind        NoticeKind
  status      NoticeStatus @default(ACTIVE)
  title       String
  body        String
  startsAt    DateTime     @default(now())
  endsAt      DateTime?
  resolvedAt  DateTime?
  createdById String
  createdBy   User         @relation(fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  products    Product[]
  tickets     Ticket[]

  @@index([status])
}

// Fixed-window counters for rate limiting (see src/lib/rate-limit.ts).
model RateLimit {
  key         String
  windowStart DateTime
  count       Int      @default(0)

  @@id([key, windowStart])
  @@index([windowStart])
}
